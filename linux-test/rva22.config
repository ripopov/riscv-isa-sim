# RVA22-oriented, Spike-oriented kernel tweaks on top of arch/riscv defconfig
CONFIG_RISCV_ISA_ZBA=y
CONFIG_RISCV_ISA_ZBB=y
CONFIG_RISCV_ISA_ZBS=y
CONFIG_RISCV_ISA_ZICBOM=y
CONFIG_RISCV_ISA_ZICBOZ=y
CONFIG_RISCV_ISA_SVPBMT=y
CONFIG_RISCV_ISA_SVNAPOT=y
CONFIG_RISCV_ISA_SVINVAL=y
# Vector is NOT part of RVA22 -> keep it out
# CONFIG_RISCV_ISA_V is not set
# initramfs is linked into the Image
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="@INITRAMFS@"
CONFIG_INITRAMFS_COMPRESSION_NONE=y
# console comes from Spike's DT (bootargs "console=ttyS0 earlycon")
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
# fewer timer ticks -> less simulator work
CONFIG_HZ_100=y
CONFIG_NO_HZ_IDLE=y
